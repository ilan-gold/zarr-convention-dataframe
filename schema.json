{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/TBD/zarr-convention-categorical/refs/tags/v1/schema.json",
    "title": "Dataframe Zarr Convention (v1)",
    "description": "Schema for the attributes of a Zarr group conforming to the dataframe convention (uuid 1f1b36d2-3185-6da8-91f6-9a0823af2d33). Describes a on-disk representation of a dataframe, can be read in with pandas, polars etc.",
    "type": "object",
    "additionalProperties": true,
    "required": [
        "zarr_conventions",
        "df:columns"
    ],
    "properties": {
        "zarr_conventions": {
            "type": "array",
            "description": "Per the Zarr Conventions spec; MUST contain a Convention Metadata Object identifying this convention.",
            "contains": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "uuid": {
                        "const": "1f1b36d2-3185-6da8-91f6-9a0823af2d33"
                    },
                    "schema_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "spec_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "uuid"
                ]
            }
        },
        "df:columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items":{
                "type": "string"
            },
            "description": "The 1d-interpretable columns of the dataframe, including the optional index."
        },
        "df:index": {
            "type": "string",
            "description": "The columns to be optionally interpreted as an index."
        }
    }
}
