{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/DOES_NOT_EXIST/zarr-dataframe/refs/tags/v1/schema.json",
    "title": "Dataframe Zarr Convention (v1)",
    "description": "Schema for the attributes of a Zarr group conforming to the dataframe convention (uuid 1f1b36d2-3185-6da8-91f6-9a0823af2d33). Describes a on-disk representation of a dataframe, can be read in with pandas, polars etc.",
    "type": "object",
    "additionalProperties": true,
    "required": [
        "zarr_conventions",
        "df:shape"
    ],
    "properties": {
        "zarr_conventions": {
            "type": "array",
            "description": "Per the Zarr Conventions spec; MUST contain a Convention Metadata Object identifying this convention.",
            "contains": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "uuid": {
                        "const": "1f1b36d2-3185-6da8-91f6-9a0823af2d33"
                    },
                    "schema_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "spec_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "uuid"
                ]
            }
        },
        "df:shape": {
            "type": "array",
            "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 }
            ],
            "items": false,
            "minItems": 2,
            "description": "Dataframe dimensions [rows, columns]. The column count includes the optional index."
        },
        "df:index": {
            "type": "integer",
            "minimum": 0,
            "description": "Column number of the dataframe index, if one exists. MUST be less than df:shape[1]; the index data is in member column_{df:index}."
        }
    }
}
